# ==============================================
# A3CEND Outreach — Environment Variables
# Copy this file to .env.local for local development
# or configure in Vercel Project Settings -> Environment Variables
# NEVER commit .env.local to source control
# ==============================================

# SendGrid Credentials
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=outreach@yourdomain.com
SENDGRID_FROM_NAME=A3CEND

# Next.js Client-Side Defaults (optional defaults for UI forms)
NEXT_PUBLIC_SENDGRID_FROM_EMAIL=outreach@yourdomain.com
NEXT_PUBLIC_SENDGRID_FROM_NAME=A3CEND

# SendGrid Dynamic Template IDs (optional defaults for new campaigns)
NEXT_PUBLIC_INITIAL_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_OPENED_NO_REPLY_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_NO_OPEN_TEMPLATE_ID=d-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (Public / Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase (Secret / Server-side only — NEVER expose to browser)
SUPABASE_SECRET_KEY=sb_secret_...

# Application URL (used for webhooks and absolute links)
# In development: http://localhost:3000
# In production: https://your-project.vercel.app
APP_URL=https://your-project.vercel.app

# Cron Security (Authorization: Bearer <CRON_SECRET>)
# Vercel automatically passes CRON_SECRET to scheduled jobs
CRON_SECRET=your_strong_random_secret_here

# SendGrid Webhook Signature Verification (optional)
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Apify Web Search API Key
APIFY_API_KEY=apify_api_xxxxxxxxxxxxxxxx

